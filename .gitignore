# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
*.egg-info/
*.egg
.venv/
venv/
ENV/
env/
.mypy_cache/
.pytype/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

