# ---------------------------------------------------------------------------
# Secrets / local configuration
# ---------------------------------------------------------------------------
# docker-compose.yml and docker-compose.dev.yml both read `.env`, which holds
# real Proxmox API tokens and database credentials. It must never be committed.
.env
.env.*
dev.env
*.env
# ...but the checked-in, placeholder-only template must stay tracked.
!.env.example

# ---------------------------------------------------------------------------
