# ProxBox configuration template.
#
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored on purpose - it holds live Proxmox API tokens and
# database credentials. Never commit it, and never paste real values back into
# this template.

# Database settings
DB_USER=proxbox
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=proxbox
DB_HOST=db
DB_PORT=5432

# Proxmox settings - Replace with your actual Proxmox details
PROXMOX_HOST=https://proxmox.example.com:8006
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=proxbox
PROXMOX_TOKEN_VALUE=CHANGE_ME_PROXMOX_API_TOKEN_VALUE
# Keep this at `true`. Setting it to `false` disables TLS certificate
# verification for every Proxmox API call, which means the API token above is
# sent over a connection that can be intercepted. See the README section
# "Proxmox TLS verification" before changing it.
PROXMOX_VERIFY_SSL=true

# App settings
# Generate a unique value per deployment, e.g.:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LDAP settings (optional)
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=ou=users
LDAP_ADMIN_GROUP=cn=admins,ou=groups,dc=example,dc=com

# OAuth settings (optional)
OAUTH_ENABLED=false
GITLAB_CLIENT_ID=CHANGE_ME_GITLAB_CLIENT_ID
GITLAB_CLIENT_SECRET=CHANGE_ME_GITLAB_CLIENT_SECRET
GITLAB_CALLBACK_URL=http://localhost:8000/api/auth/callback/gitlab

# Frontend settings
VITE_API_URL=http://localhost:8000/api
NODE_ENV=development
